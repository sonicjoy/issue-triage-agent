# Copy to .env and fill in. .env is git-ignored: never commit real keys.
# Every setting the project reads is listed here (a test checks this).

# --- Models ----------------------------------------------------------------
# Format: <provider>:<model>. Providers: anthropic, google_genai, openai.
# Model for agents:
AFR_LLM_MODEL=anthropic:claude-sonnet-5-5
# Cheaper model for the LLM judge and bulk work:
AFR_LLM_CHEAP_MODEL=anthropic:claude-haiku-5-5

# --- Provider keys (only the ones you use) ----------------------------------
# Anthropic: local development and bulk runs only.
# Never put it in GitHub secrets, CI or the deployed instance.
ANTHROPIC_API_KEY=

# Google Gemini API, free tier, from a personal Google AI Studio account.
# Also stored as a GitHub Actions secret for evals in CI.
GOOGLE_API_KEY=

# OpenAI (optional; not used by default).
OPENAI_API_KEY=
